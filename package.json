{
  "name": "signal-copier",
  "version": "1.1.0",
  "description": "Telegram to MT5 Signal Copier",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run vite:build && electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=dev electron .\"",
    "dev:instance:demo": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=dev electron . --instance=demo\"",
    "dev:instance:live": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=dev electron . --instance=live\"",
    "vite:build": "vite build",
    "build": "node tools/runtime/prepare-electron-build.mjs && npm run icons:generate && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:portable": "node tools/runtime/prepare-electron-build.mjs --portable-only && npm run icons:generate && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILD_SCOPE=portable electron-builder --win dir portable --config.directories.output=dist/portable",
    "build:release": "node tools/runtime/prepare-electron-build.mjs && npm run icons:generate && vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis portable dir",
    "build:signed": "npm run icons:generate && vite build && electron-builder",
    "pack": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "icons:generate": "node tools/runtime/generate-app-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.tradesync.signalcopier",
    "productName": "Trade Station",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "publisherName": "Trade Station",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Trade-Station-Setup.exe"
    },
    "portable": {
      "artifactName": "Trade-Station-Portable.exe"
    },
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "."
      }
    ],
    "files": [
      "src/main/**/*",
      "dist/renderer/**/*",
      "public/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "archiver": "^8.0.0",
    "cmdk": "^1.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.38.0",
    "input": "^1.0.1",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^1.9.0",
    "pdfkit": "^0.18.0",
    "react-day-picker": "^9.14.0",
    "telegram": "^2.19.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "sharp": "^0.34.5",
    "vite": "^5.0.8",
    "vitest": "^2.1.5",
    "wait-on": "^7.2.0"
  }
}
